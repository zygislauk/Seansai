{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "seansai_lang",
          "value": "en"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/lt/",
      "permanent": false
    },
    {
      "source": "/:lang((?!lt|en)[a-z]{2})/:path*",
      "destination": "/lt/:path*",
      "permanent": true
    }
  ],
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "index.ts"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "routes": [
        {
          "src": "/(.*)",
          "headers": {
            "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
            "X-Content-Type-Options": "nosniff",
            "Referrer-Policy": "strict-origin-when-cross-origin"
          },
          "continue": true
        },
        {
          "src": "/assets/(.*)",
          "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          },
          "continue": true
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "/.*",
          "status": 404,
          "dest": "/404.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
